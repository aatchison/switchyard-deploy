# container-switchyard-main.service
# Rootless Podman + systemd user service for Switchyard (main branch build) on :4001.
# Runs SIDE-BY-SIDE with container-switchyard.service (v0.2.0-cachefix on :4000).
# Key read from deploy/.env (EnvironmentFile), never stored in this unit.
# Manage:  systemctl --user {start|stop|restart|status} container-switchyard-main

[Unit]
Description=Switchyard LLM router - main build (Podman, :4001)
Documentation=man:podman-generate-systemd(1)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%h/switchyard-deploy/deploy/.env
Restart=always
RestartSec=3
TimeoutStopSec=70
ExecStartPre=/usr/bin/chmod 0644 %h/switchyard-deploy/deploy/routes.anthropic.toml
ExecStart=/usr/bin/podman run \
	--cidfile=%t/%n.ctr-id \
	--cgroups=no-conmon \
	--rm \
	--sdnotify=conmon \
	--replace \
	-d \
	--name switchyard-main \
	--userns=keep-id \
	-p 127.0.0.1:4001:4001 \
	-e ANTHROPIC_API_KEY \
	-e SWITCHYARD_TELEMETRY_OPT_OUT=1 \
	-v %h/switchyard-deploy/deploy/routes.anthropic.toml:/etc/switchyard/routes.toml:ro,Z \
	-v %h/switchyard-deploy/deploy/logs:/var/log/switchyard:Z localhost/switchyard-server:main \
	--config /etc/switchyard/routes.toml \
	--host 0.0.0.0 \
	--port 4001 \
	--routing-log-file /var/log/switchyard/routing-main.jsonl
ExecStop=/usr/bin/podman stop \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm \
	-f \
	--ignore -t 10 \
	--cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
